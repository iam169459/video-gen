# VideoGen AI Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=VideoGen AI
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=your-secret-key-here-change-in-production

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Paths
DATA_DIR=/app/data
MODELS_DIR=/app/data/models
OUTPUT_DIR=/app/data/outputs
TEMP_DIR=/app/data/temp
LOGS_DIR=/app/data/logs
CACHE_DIR=/app/data/cache

# Model Configuration
DEFAULT_LLM_MODEL=meta-llama/Llama-2-7b-chat-hf
DEFAULT_VIDEO_MODEL=stabilityai/stable-video-diffusion-img2vid-xt
MAX_MODEL_SIZE_GB=50
CHAIN_BLOCK_SIZE=4
CHAIN_OVERLAP=1
CHAIN_MAX_BLOCKS=8
CHAIN_TIMEOUT_SECONDS=300

# GPU/Compute
DEVICE=auto
USE_FP16=true
USE_BF16=false
ENABLE_XFORMERS=true
ENABLE_CPU_OFFLOAD=true
MAX_GPU_MEMORY_GB=

# Video Generation
DEFAULT_FPS=8
DEFAULT_FRAMES=25
DEFAULT_RESOLUTION=576x1024
MAX_FRAMES=100
MAX_RESOLUTION=1024x1024

# Download Manager
DOWNLOAD_CHUNK_SIZE=8192
MAX_CONCURRENT_DOWNLOADS=3
DOWNLOAD_TIMEOUT=3600
VERIFY_CHECKSUMS=true
HUGGINGFACE_TOKEN=

# Redis/Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# WebSocket
WS_HEARTBEAT_INTERVAL=30
WS_MAX_MESSAGE_SIZE=10485760

# Update System
UPDATE_CHECK_INTERVAL_HOURS=24
AUTO_UPDATE_ENABLED=false
UPDATE_CHANNEL=stable
GITHUB_REPO=your-username/video-gen
GITHUB_TOKEN=

# Security
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
ALLOWED_HOSTS=["*"]
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
LOG_LEVEL=INFO
LOG_ROTATION=10 MB
LOG_RETENTION=7 days